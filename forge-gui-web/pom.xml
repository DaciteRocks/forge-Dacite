<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <artifactId>forge</artifactId>
        <groupId>forge</groupId>
        <version>${revision}</version>
    </parent>

    <artifactId>forge-gui-web</artifactId>
    <packaging>jar</packaging>
    <name>Forge GUI Web</name>
    <description>
        Browser-based thin client for Forge. Runs a WebSocket + static-file host in the JVM and
        implements IGuiGame (WebGuiGame) as a sibling of the network client's RemoteClientGuiGame,
        streaming game state to the browser as JSON. The rules engine runs unchanged on the host;
        the browser is a dumb renderer. See docs/Development/Web-Client-Spec.md.
    </description>

    <dependencies>
        <!-- Forge GUI layer: pulls in forge-ai -> forge-game -> forge-core,
             plus the net protocol (ProtocolMethod), the View model, and game-mode logic.
             Excludes forge-gui's transitive Jetty 9.4 / javax.servlet: Javalin 6 needs Jetty 11
             (jakarta.servlet), and having both on the classpath makes the old Jetty win and throw
             NoSuchMethodError at server start. We never invoke Forge's own Jetty-based features. -->
        <dependency>
            <groupId>forge</groupId>
            <artifactId>forge-gui</artifactId>
            <version>${project.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>org.eclipse.jetty</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>javax.servlet</groupId>
                    <artifactId>javax.servlet-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Embedded HTTP + WebSocket host (bundles Jetty). -->
        <dependency>
            <groupId>io.javalin</groupId>
            <artifactId>javalin</artifactId>
            <version>6.3.0</version>
        </dependency>

        <!-- JSON encode/decode for the game protocol. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.17.2</version>
        </dependency>

        <!-- SLF4J simple binding so Javalin/Jetty logging has an implementation at runtime. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>2.0.13</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Test framework (matches the rest of the project). -->
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>7.10.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Build a self-contained runnable jar (all deps + merged service files) so the client
                 launches with `java -jar` — no Maven at runtime, which sidesteps the ${revision}
                 parent-resolution problem that blocks single-module runs. Build it with the reactor:
                   mvn -pl forge-gui-web -am -DskipTests package
                 then run from the repo root (so res/ card data resolves):
                   java -jar forge-gui-web/target/forge-gui-web-*-jar-with-dependencies.jar -->
            <plugin>
                <artifactId>maven-assembly-plugin</artifactId>
                <configuration>
                    <attach>false</attach>
                    <descriptors>
                        <descriptor>src/main/assembly/jar-with-dependencies.xml</descriptor>
                    </descriptors>
                    <archive>
                        <manifestEntries>
                            <Main-Class>forge.gui.web.WebMatchLauncher</Main-Class>
                            <!-- The engine reflects into these JDK packages at runtime (mirrors the
                                 root pom's surefire argLine); the manifest opens them to this jar. -->
                            <Add-Opens>
<![CDATA[
  java.base/java.lang
  java.base/java.time
  java.base/java.text
  java.base/java.util
  java.base/java.util.regex
  java.base/java.util.stream
  java.base/java.lang.reflect
  java.desktop/javax.imageio.spi
]]>
                            </Add-Opens>
                        </manifestEntries>
                    </archive>
                </configuration>
                <executions>
                    <execution>
                        <id>make-runnable-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
